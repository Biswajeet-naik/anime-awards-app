<resources>
    <style name="Theme.AnimeAwards" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#6750A4</item>
        <item name="colorPrimaryDark">@color/night_top</item>
        <item name="colorAccent">#B8A6FF</item>
        <item name="colorControlNormal">@color/glass_muted</item>
        <item name="android:windowBackground">@drawable/bg_night</item>
        <item name="android:statusBarColor">@color/night_top</item>
        <item name="android:navigationBarColor">@color/night_bottom</item>
        <item name="android:textColorHint">#8E90B8</item>
        <item name="buttonStyle">@style/Widget.Glass.Button</item>
    </style>

    <style name="Widget.Glass.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Glass.Arrow" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_arrow</item>
        <item name="android:textColor">@color/glass_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
