<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ed_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/categoryNumber"
            style="@style/Ed.Display"
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:textColor="@color/ed_dim"
            android:textSize="52sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/categoryName"
                style="@style/Ed.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:maxLines="2"
                android:textAllCaps="true"
                android:textColor="@color/ed_ivory"
                android:textSize="23sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/winnerLabel"
                style="@style/Ed.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/winnerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ed_ivory"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/winnerPoster"
            android:layout_width="62dp"
            android:layout_height="93dp"
            android:background="@drawable/bg_ed_slot"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </LinearLayout>
</LinearLayout>
